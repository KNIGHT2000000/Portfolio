---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { engineeringFocusAreas, technologyGroups, architecturalCompetencies } from '@/data/skills';
import { siteConfig } from '@/data/siteConfig';

const pageTitle = `Engineering Philosophy & Technical Stack | ${siteConfig.author}`;
const pageDesc = "Technical competencies, distributed system patterns, and grouped technology stack for Backend & Cloud Engineering.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="eng-page-header">
    <div class="container container-narrow">
      <span class="section-label">Architecture &amp; Skills</span>
      <h1 class="page-headline">Engineering &amp; Systems</h1>
      <p class="page-subline">
        A deep breakdown of core technical domains, runtime technologies, data storage topologies, and distributed design principles.
      </p>
    </div>
  </div>

  <div class="container container-narrow eng-page-body">
    <!-- 1. Areas of Interest -->
    <section class="eng-section">
      <div class="section-header">
        <span class="section-label">Core Domains</span>
        <h2 class="section-title">Areas of Interest</h2>
        <p class="section-desc">
          High-level engineering disciplines and operational focuses that guide my development decisions.
        </p>
      </div>

      <div class="interests-grid">
        {engineeringFocusAreas.map((area) => (
          <div class="card interest-card">
            <h3 class="interest-title">{area.title}</h3>
            <p class="interest-desc">{area.summary}</p>
            <div class="interest-tags">
              {area.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 2. Grouped Technologies -->
    <section class="eng-section">
      <div class="section-header">
        <span class="section-label">Technical Stack</span>
        <h2 class="section-title">Grouped Technologies</h2>
        <p class="section-desc">
          Tools, languages, and platforms organized by runtime role. No arbitrary percentage bars — only concrete architectural concepts.
        </p>
      </div>

      <div class="tech-groups-stack">
        {technologyGroups.map((group) => (
          <div class="card tech-group-card">
            <div class="tech-group-header">
              <h3 class="tech-group-name">{group.category}</h3>
              <p class="tech-group-desc">{group.description}</p>
            </div>

            <div class="tech-items-grid">
              {group.items.map((item) => (
                <div class="tech-item-row">
                  <div class="tech-item-name">
                    <code>{item.name}</code>
                  </div>
                  <div class="tech-item-concepts">
                    {item.concepts.map((concept) => (
                      <span class="concept-pill">{concept}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Architectural Competencies & Patterns -->
    <section class="eng-section">
      <div class="section-header">
        <span class="section-label">Systems Design</span>
        <h2 class="section-title">Architectural Competencies</h2>
        <p class="section-desc">
          Practical strategies for preserving state consistency, mitigating cascading failures, and providing operational observability.
        </p>
      </div>

      <div class="competencies-stack">
        {architecturalCompetencies.map((comp) => (
          <div class="card comp-card">
            <h3 class="comp-title">{comp.title}</h3>
            <p class="comp-desc">{comp.description}</p>
            <div class="comp-practices">
              <span class="practices-label">Key Practices:</span>
              {comp.keyPractices.map((practice) => (
                <span class="tag tag-accent">{practice}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .eng-page-header {
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
  }

  .page-headline {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .page-subline {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .eng-page-body {
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .eng-section {
    margin-bottom: 4.5rem;
  }

  /* Areas of Interest Grid */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .interest-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .interest-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .interest-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .interest-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  /* Grouped Tech */
  .tech-groups-stack {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .tech-group-card {
    padding: 2rem;
  }

  .tech-group-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .tech-group-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .tech-group-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .tech-items-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tech-item-row {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--border-color);
  }

  .tech-item-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .tech-item-name {
    min-width: 140px;
  }

  .tech-item-name code {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--accent-primary);
    background-color: var(--accent-surface);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .tech-item-concepts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    flex-grow: 1;
  }

  .concept-pill {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background-color: var(--bg-surface-elevated);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  /* Competencies */
  .competencies-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .comp-card {
    padding: 1.75rem;
  }

  .comp-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .comp-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .comp-practices {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .practices-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .tech-item-row {
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }
  }
</style>
