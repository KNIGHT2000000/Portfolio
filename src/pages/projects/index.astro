---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, projectCategories } from '@/data/projects';
import { siteConfig } from '@/data/siteConfig';

const pageTitle = `Engineering Projects | ${siteConfig.author}`;
const pageDesc = "Architectural case studies and systems built by a Backend & Cloud Engineer.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="projects-page-header">
    <div class="container">
      <span class="section-label">Architecture Portfolio</span>
      <h1 class="page-headline">Engineering Projects</h1>
      <p class="page-subline">
        System designs, distributed services, and cloud automation utilities. Filter by engineering category below.
      </p>

      <!-- Category Filter Tabs -->
      <div class="filter-bar" role="toolbar" aria-label="Filter projects by technology domain">
        {projectCategories.map((category, idx) => (
          <button
            type="button"
            class:list={['filter-btn', { active: idx === 0 }]}
            data-filter={category.toLowerCase()}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {category}
          </button>
        ))}
      </div>
    </div>
  </div>

  <section class="section projects-list-section">
    <div class="container">
      <div class="projects-grid" id="projects-container">
        {projects.map((project) => (
          <div class="project-wrapper" data-category={project.category.toLowerCase()}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>

      <!-- No matches fallback -->
      <div id="no-projects-msg" class="card empty-filter-state" style="display: none;">
        <p>No projects currently listed under this category.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page-header {
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
  }

  .page-headline {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .page-subline {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin-bottom: 2rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .filter-btn.active {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #ffffff;
  }

  .projects-list-section {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 1.75rem;
  }

  .project-wrapper {
    display: block;
    height: 100%;
  }

  .project-wrapper.hidden {
    display: none !important;
  }

  .empty-filter-state {
    padding: 3rem;
    text-align: center;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  function setupProjectFiltering() {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.project-wrapper');
    const emptyMsg = document.getElementById('no-projects-msg');

    if (!buttons.length || !items.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';

        // Update active button state
        buttons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        let visibleCount = 0;

        items.forEach((item) => {
          const category = item.getAttribute('data-category') || '';
          if (filter === 'all' || category === filter) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (emptyMsg) {
          emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  }

  setupProjectFiltering();
  document.addEventListener('astro:after-swap', setupProjectFiltering);
</script>
