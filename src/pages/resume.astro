---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';
import { resolveUrl } from '@/utils/url';
import { siteConfig } from '@/data/siteConfig';

const pageTitle = `Resume — ${profile.name} | ${profile.role}`;
const pageDesc = `Curriculum vitae and technical background of ${profile.name}, Backend & Cloud Engineer.`;

const resumeUrl = profile.resume.startsWith('http') ? profile.resume : resolveUrl(profile.resume);
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="resume-page-header">
    <div class="container container-narrow">
      <div class="resume-header-row">
        <div>
          <span class="section-label">Curriculum Vitae</span>
          <h1 class="page-headline">{profile.name}</h1>
          <p class="page-subline">{profile.role} • Technical Resume</p>
        </div>

        <div class="resume-actions">
          <a
            href={resumeUrl}
            download="resume.pdf"
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download PDF
          </a>

          <a
            href={resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            Open in New Tab
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container container-narrow resume-body">
    <!-- Embedded PDF Viewer with Fallback -->
    <div class="card resume-card">
      <div class="resume-viewer-container">
        <object
          data={resumeUrl}
          type="application/pdf"
          width="100%"
          height="800px"
          class="pdf-viewer"
        >
          <div class="pdf-fallback">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="fallback-icon" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <h3 class="fallback-title">PDF Preview Not Available on This Device</h3>
            <p class="fallback-desc">
              Your browser or mobile screen does not support inline PDF rendering. You can download or view the PDF directly using the button below.
            </p>
            <a href={resumeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Open Resume (PDF)
            </a>
          </div>
        </object>
      </div>
    </div>

    <!-- Instructions Notice for Engineer -->
    <div class="resume-note-box">
      <p>
        <strong>Note for portfolio owner:</strong> To replace this placeholder, place your final PDF in <code>public/resume.pdf</code> or update the <code>resume</code> URL property in <code>src/data/profile.ts</code>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .resume-page-header {
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
  }

  .resume-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .page-headline {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .page-subline {
    font-size: 1.0625rem;
    color: var(--accent-primary);
    font-family: var(--font-mono);
  }

  .resume-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .resume-body {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .resume-card {
    padding: 0;
    overflow: hidden;
    background-color: var(--bg-surface);
  }

  .resume-viewer-container {
    width: 100%;
    min-height: 600px;
    background-color: var(--bg-surface-elevated);
  }

  .pdf-viewer {
    display: block;
    width: 100%;
    height: 850px;
    border: none;
  }

  .pdf-fallback {
    padding: 4rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .fallback-icon {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .fallback-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .fallback-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    max-width: 480px;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .resume-note-box {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-color);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .resume-note-box code {
    font-size: 0.8125rem;
    color: var(--accent-primary);
    background-color: var(--accent-surface);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 640px) {
    .resume-header-row {
      flex-direction: column;
      align-items: stretch;
    }
    .resume-actions {
      flex-direction: column;
    }
    .pdf-viewer {
      height: 500px;
    }
  }
</style>
