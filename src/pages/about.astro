---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profile } from '@/data/profile';
import { resolveUrl } from '@/utils/url';
import { siteConfig } from '@/data/siteConfig';

const pageTitle = `About ${profile.name} — Engineering Profile`;
const pageDesc = "Professional background, architectural philosophy, and technical direction of a Backend & Cloud Engineer.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="about-page-header">
    <div class="container container-narrow">
      <span class="section-label">Engineer Profile</span>
      <h1 class="page-headline">About &amp; Background</h1>
      <p class="page-subline">{profile.about.lead}</p>
    </div>
  </div>

  <div class="container container-narrow about-page-body">
    <!-- 1. Professional Introduction -->
    <section class="about-section">
      <h2 class="section-title">Professional Overview</h2>
      <div class="card intro-card">
        {profile.about.paragraphs.map((p) => (
          <p class="about-paragraph">{p}</p>
        ))}
      </div>
    </section>

    <!-- 2. Technical Philosophy -->
    <section class="about-section">
      <h2 class="section-title">Engineering Principles</h2>
      <div class="principles-grid">
        {profile.about.technicalPhilosophy.map((item) => (
          <div class="card principle-card">
            <h3 class="principle-title">{item.title}</h3>
            <p class="principle-desc">{item.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Education -->
    <section class="about-section">
      <h2 class="section-title">Education &amp; Foundations</h2>
      <div class="education-stack">
        {profile.about.education.map((edu) => (
          <div class="card edu-card">
            <div class="edu-header">
              <div>
                <h3 class="edu-degree">{edu.degree}</h3>
                <p class="edu-institution">{edu.institution}</p>
              </div>
              <span class="edu-year">{edu.year}</span>
            </div>
            {edu.focus && <p class="edu-focus">{edu.focus}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Career & Technical Interests -->
    <section class="about-section">
      <h2 class="section-title">Target Roles &amp; Focus</h2>
      <div class="card interests-card">
        <ul class="interests-checklist">
          {profile.about.careerInterests.map((interest) => (
            <li class="interest-item">
              <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{interest}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Quick Action / Resume CTA -->
    <div class="about-action-bar">
      <a
        href={profile.resume.startsWith('http') ? profile.resume : resolveUrl(profile.resume)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        Download Resume (PDF)
      </a>

      {profile.github && (
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
          Inspect GitHub Repositories ↗
        </a>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .about-page-header {
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
  }

  .page-headline {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .page-subline {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .about-page-body {
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .about-section {
    margin-bottom: 3.5rem;
  }

  .intro-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-paragraph {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Principles */
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .principle-card {
    padding: 1.5rem;
  }

  .principle-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .principle-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* Education */
  .education-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu-card {
    padding: 1.75rem;
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .edu-degree {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .edu-institution {
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .edu-year {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-primary);
    background-color: var(--accent-surface);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .edu-focus {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  /* Interests Checklist */
  .interests-card {
    padding: 1.75rem;
  }

  .interests-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .interest-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .check-icon {
    color: var(--accent-emerald);
    flex-shrink: 0;
  }

  .about-action-bar {
    display: flex;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .about-action-bar {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
