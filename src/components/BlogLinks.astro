---
import { blogs } from '@/data/blogs';
---

<section class="section engineering-notes-section" id="notes">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Technical Publications</span>
      <h2 class="section-title">Engineering Notes</h2>
      <p class="section-desc">
        Deep dives into distributed state management, concurrency boundaries, and infrastructure operational lessons.
      </p>
    </div>

    {blogs && blogs.length > 0 ? (
      <div class="notes-list">
        {blogs.map((item) => (
          <article class="card note-card">
            <div class="note-meta">
              <span class="note-topic">{item.topic}</span>
              <span class="note-dot" aria-hidden="true">•</span>
              <time class="note-date">{item.date}</time>
              {item.readTime && (
                <>
                  <span class="note-dot" aria-hidden="true">•</span>
                  <span class="note-read-time">{item.readTime}</span>
                </>
              )}
            </div>

            <h3 class="note-title">
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="note-link">
                {item.title}
              </a>
            </h3>

            <p class="note-description">{item.description}</p>

            <div class="note-action">
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="read-link"
                aria-label={`Read engineering article: ${item.title}`}
              >
                Read article
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <!-- Professional Empty State Placeholder when no blogs exist -->
      <div class="card notes-empty-state">
        <div class="empty-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <h3 class="empty-title">Engineering write-ups coming soon.</h3>
        <p class="empty-desc">
          Technical deep-dives and architecture post-mortems will be published here.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .note-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .note-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-accent);
    box-shadow: var(--shadow-md);
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin-bottom: 0.625rem;
    color: var(--text-muted);
  }

  .note-topic {
    color: var(--accent-primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .note-dot {
    color: var(--text-muted);
  }

  .note-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 0.625rem;
  }

  .note-link {
    color: var(--text-primary);
    text-decoration: none;
  }

  .note-link:hover {
    color: var(--accent-primary);
  }

  .note-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 820px;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .read-link:hover {
    transform: translateX(3px);
    color: var(--accent-primary-hover);
  }

  /* Empty State */
  .notes-empty-state {
    padding: 3rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .empty-icon {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .empty-title {
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
</style>
