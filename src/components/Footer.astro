---
import { profile } from '@/data/profile';
import { resolveUrl } from '@/utils/url';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-container">
    <div class="footer-identity">
      <p class="footer-name">{profile.name}</p>
      <p class="footer-role">{profile.role}</p>
      <p class="footer-tagline">{profile.tagline}</p>
    </div>

    <div class="footer-nav">
      <div class="footer-column">
        <span class="footer-heading">Navigation</span>
        <ul class="footer-links">
          <li><a href={resolveUrl('/')}>Home</a></li>
          <li><a href={resolveUrl('/projects')}>Projects</a></li>
          <li><a href={resolveUrl('/engineering')}>Engineering</a></li>
          <li><a href={resolveUrl('/about')}>About</a></li>
        </ul>
      </div>

      <div class="footer-column">
        <span class="footer-heading">Connect</span>
        <ul class="footer-links">
          {profile.github && (
            <li>
              <a href={profile.github} target="_blank" rel="noopener noreferrer">
                GitHub ↗
              </a>
            </li>
          )}
          {profile.linkedin && (
            <li>
              <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
                LinkedIn ↗
              </a>
            </li>
          )}
          {profile.email && (
            <li>
              <a href={profile.email}>
                Email ↗
              </a>
            </li>
          )}
          {profile.resume && (
            <li>
              <a href={profile.resume.startsWith('http') ? profile.resume : resolveUrl(profile.resume)} target="_blank" rel="noopener noreferrer">
                Resume (PDF) ↗
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="copyright">
      &copy; {currentYear} {profile.name}. Completely static architecture — zero servers, zero tracking.
    </p>
    <a href="#top" class="back-to-top">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    padding: 3.5rem 0 2rem;
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .footer-identity {
    max-width: 380px;
  }

  .footer-name {
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .footer-role {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-primary);
    margin-bottom: 0.75rem;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .footer-nav {
    display: flex;
    gap: 3.5rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .back-to-top {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .back-to-top:hover {
    color: var(--accent-primary);
  }

  @media (max-width: 640px) {
    .footer-container {
      flex-direction: column;
      gap: 2rem;
    }
    .footer-nav {
      gap: 2.5rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>
