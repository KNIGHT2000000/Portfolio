---
import type { Project } from '@/data/projects';
import { resolveUrl } from '@/utils/url';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Determine primary doc link if any exist
const docLink = project.documentation?.architecture ||
  project.documentation?.api ||
  project.documentation?.deployment ||
  project.documentation?.general;
---

<article class="card project-card" data-category={project.category}>
  <div class="project-header">
    <div class="meta-row">
      <span class="project-category">{project.category}</span>
      {project.status && (
        <span class:list={['status-indicator-tag', project.status.toLowerCase().replace(' ', '-')]}>
          {project.status}
        </span>
      )}
    </div>
    <h3 class="project-title">
      <a href={resolveUrl(`/projects/${project.slug}`)} class="title-link">
        {project.title}
      </a>
    </h3>
  </div>

  <p class="project-description">
    {project.description}
  </p>

  <!-- Technology Stack Badges -->
  <div class="project-tech-stack">
    {project.technologies.map((tech) => (
      <span class="tag">{tech}</span>
    ))}
  </div>

  <!-- Action Links (Strict Conditional Rendering - No Empty Links) -->
  <div class="project-footer">
    <div class="project-links">
      {project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link"
          aria-label={`View GitHub source code for ${project.title}`}
          title="Source Code"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>
      )}

      {docLink && (
        <a
          href={docLink}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link"
          aria-label={`View technical documentation for ${project.title}`}
          title="Architecture / API Docs"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          <span>Docs</span>
        </a>
      )}

      {project.blog?.url && (
        <a
          href={project.blog.url}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link"
          aria-label={`Read engineering write-up for ${project.title}`}
          title="Engineering Write-up"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span>Blog</span>
        </a>
      )}

      {project.demo && (
        <a
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link"
          aria-label={`View live demo for ${project.title}`}
          title="Live Demo"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span>Demo</span>
        </a>
      )}
    </div>

    <a href={resolveUrl(`/projects/${project.slug}`)} class="case-study-btn">
      Case Study →
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
  }

  .project-header {
    margin-bottom: 0.875rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-primary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-indicator-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface-elevated);
    color: var(--text-muted);
  }

  .status-indicator-tag.completed {
    background-color: var(--accent-emerald-surface);
    color: var(--accent-emerald);
  }

  .status-indicator-tag.active,
  .status-indicator-tag.in-progress {
    background-color: var(--accent-surface);
    color: var(--accent-primary);
  }

  .project-title {
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .title-link {
    color: var(--text-primary);
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--accent-primary);
  }

  .project-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .project-tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .project-link:hover {
    color: var(--accent-primary);
  }

  .case-study-btn {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .case-study-btn:hover {
    color: var(--accent-primary-hover);
    transform: translateX(2px);
  }
</style>
